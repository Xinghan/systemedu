{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Local learning host protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "session",
    "activity",
    "request_id",
    "method"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "session": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "activity": {
      "enum": [
        "mechanical-hand",
        "mars-landing",
        "driving-intro"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "method": {
      "enum": [
        "load",
        "save",
        "export"
      ]
    },
    "state": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "const": "save"
          }
        }
      },
      "then": {
        "required": [
          "state"
        ]
      }
    }
  ]
}
