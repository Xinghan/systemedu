{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Course release v1 — additive mobile envelope",
  "type": "object",
  "required": [
    "schema_version",
    "slug",
    "version",
    "release_id",
    "files",
    "activities",
    "runtime_requirements",
    "offline_capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "course-release/1"
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "library_slug",
          "module_id",
          "activity_id",
          "kind",
          "content_version"
        ],
        "properties": {
          "library_slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "module_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "activity_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "content_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "enum": [
              "classroom",
              "assignment",
              "quiz",
              "exam"
            ]
          }
        }
      }
    },
    "runtime_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "offline_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
