  "sideQuest": "lightkurve-transit-detective",
  "bridges": [
    {
      "id": "B-HARDWARE",
      "title": "在已有打印车上升级 Raspberry Pi/相机，保留 Pico 驱动与触碰停止",
      "status": "required-not-implemented",
      "acceptance": "同一辆车升级前后版本可追溯；架空单测与低速停止/失联测试记录齐全。"
    },
    {
      "id": "B-LABELS",
      "title": "区分两类近邻练习、五类轨道影像训练、地面相机域外测试",
      "status": "required-adaptation",
      "acceptance": "提交类别对应与不对应清单，保存目标相机采集条件及真实失败，不能把 sand→dune 当自动转换。"
    },
    {
      "id": "B-NAVIGATION",
      "title": "完成预先声明场地内的路线执行、到点判定、超时和停止闭环",
      "status": "critical-gap-not-implemented",
      "acceptance": "新路线实测能区分调速正确、路线执行正确、到点确认及被安全中止；禁止把分类器准确率当任务通过。"
    }
  ],
  "commander": {
    "name": "林岚",
    "title": "基地任务负责人",
    "research": "接下来你可以试一次远距离观测。火星车能靠近岩石，Kepler 望远镜却看不清遥远恒星旁的行星。我把一张星光记录交给你。先看看光有多亮，再判断我们还需要什么证据。",
    "projects": {
      "spot-a-world": "把望远镜转向火星，拍下一张照片。选一处你能辨认的特征，在记录里指出它的位置。",
      "land-a-probe": "给着陆器安排一次减速。再换一个减速时刻，告诉我哪一次着陆更平稳。",
      "drive-and-frame": "开车绕过岩石，选一个能看清地形的位置拍照，回来告诉我为什么在那里停车。",
      "pick-an-observation-site": "我需要知道车要开到哪里去。选一个值得调查的地点，用地图上的位置和尺度说明理由。",
      "plan-a-payload": "把你的观察问题带过来。载荷空间有限，选出能回答这个问题的仪器，并留下预算。",
      "tune-a-chassis": "仪器清单有了，我想知道车能不能载着它们走。比较底盘设置，记下车身在哪种情况下较稳。",
      "assemble-a-rover": "把设计图变成能检查的装配方案。先找出一个接口，说明两侧怎样固定，又要留出多少空间。",
      "write-driving-rules": "把驾驶员的一个判断写成车能执行的规则。换一条路线，验证它该停的时候是否停了。",
      "label-the-terrain": "挑两张容易认错的地形照片。给队友写一条标注约定，再比较你们圈出的区域。",
      "mars-analog-rover": "这辆车要从图纸走到试验场。对照当前任务站的要求，把本次使用的版本和实际测量留下来。",
      "run-an-expedition": "这次由你领队。先定目标、路线和停止条件，保存第一次尝试，再根据记录安排复测。",
      "lightkurve-transit-detective": "这次把望远镜对准 Kepler-10。找出星光记录中一处可以核对的变化，再告诉我哪些原因还要查。"
    }
  }
