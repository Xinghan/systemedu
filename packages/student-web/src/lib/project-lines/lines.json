    "courseSlugs": [
      "molecule-monster-hunter"
    ],
    "planned": [
      {
        "id": "turn-a-molecule",
        "kind": "micro",
        "title": {
          "zh": "转动我的第一个分子",
          "en": "Meet a molecule"
        },
        "action": "转动预置分子，选择一处原子或环并保存观察视角。",
        "outcome": {
          "zh": "一张带标记的分子观察卡",
