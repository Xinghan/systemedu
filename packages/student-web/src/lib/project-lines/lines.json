        "id": "check-a-prediction",
        "kind": "guided",
        "title": {
          "zh": "检验一次 AI 预测",
          "en": "Check an AI prediction"
        },
        "action": "比较固定模型对未见样本的预测和给定测量值，标出误差大的案例。",
        "outcome": {
          "zh": "带测试划分的误差记录",
          "en": "A test split and error record"
        },
        "estimatedMinutes": 45,
        "learningNodes": [
          "预测不等于测量",
          "留出数据做检验",
          "解释错误与不确定"
        ]
      },
      {
        "id": "assemble-a-discovery-desk",
        "kind": "integration",
        "title": {
          "zh": "组装分子候选工作台",
          "en": "Assemble a discovery desk"
        },
        "action": "把自己的筛选规则或误差检查配置接入平台分子库，运行并导出候选说明。",
        "outcome": {
          "zh": "自己的候选报告与运行配置",
          "en": "A candidate report and configuration"
