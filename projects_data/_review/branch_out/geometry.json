{
  "concepts": [
    {
      "id": "m.angle",
      "name_zh": "角度",
      "name_en": "Angle",
      "type": "CONCEPTUAL",
      "grade_band": "elementary",
      "subject": "Mathematics",
      "description": "两条射线张开多大用度数量。义肢课里舵机要转到多少度、火星车航向朝哪个方向、火星车倾斜多少度都是角度；也是后面三角函数和旋转的入门。",
      "wikidata_search": "angle geometry",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.area",
      "name_zh": "面积",
      "name_en": "Area",
      "type": "CONCEPTUAL",
      "grade_band": "elementary",
      "subject": "Mathematics",
      "description": "一块平面区域有多大。分子课看分子极性表面积 TPSA、用 ROC 曲线下面积 AUC 给模型打分，卫星考古框研究区、看几何土工围出的图形，都是在数‘围起来的面积’。",
      "wikidata_search": "area geometry",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.number_line_coordinate",
      "name_zh": "数轴与坐标直觉",
      "name_en": "Number line",
      "type": "CONCEPTUAL",
      "grade_band": "elementary",
      "subject": "Mathematics",
      "description": "把数按大小摆到一条直线上、用一个数标出位置。空气质量课先在数轴上认‘一个数定一个位置’，再升级到平面坐标系画浓度-AQI 图；是所有坐标系的起点。",
      "wikidata_search": "number line",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.coordinate_system",
      "name_zh": "平面直角坐标系",
      "name_en": "Cartesian coordinate system",
      "type": "REPRESENTATIONAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "用横轴纵轴两个数 (x, y) 精确定位平面上一个点。空气质量课用它画浓度-AQI 图和所有散点图，火星车把行驶路线画到坐标图上，是数据可视化和地图的地基。",
      "wikidata_search": "Cartesian coordinate system",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.geographic_coordinates",
      "name_zh": "地理坐标(经纬度)",
      "name_en": "Geographic coordinate system",
      "type": "REPRESENTATIONAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "用经度纬度两个角度给地球表面任意一点定位，是球面上的坐标系。火星车用它记录行驶位置，空气质量节点用 GPS 坐标注册上地图，卫星考古用它把影像像素对齐到真实地点、框出研究区。",
      "wikidata_search": "geographic coordinate system latitude longitude",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.distance_metric",
      "name_zh": "距离(两点间距离)",
      "name_en": "Euclidean distance",
      "type": "PROCEDURAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "两个点隔多远，用坐标差的平方和开根算。空气质量课看每个点离拟合线多远(残差)、离 45 度对角线多远来判准不准，蚂蚁 RFID 标签的读取距离、分子相似度都在量‘差多远’。",
      "wikidata_search": "Euclidean distance",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.pythagorean_theorem",
      "name_zh": "勾股定理",
      "name_en": "Pythagorean theorem",
      "type": "CONCEPTUAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "直角三角形两直角边平方和等于斜边平方。它是‘两点间直线距离’公式的来源，也让向量长度(范数)、火星车在平面上算走了多远都有了根据。",
      "wikidata_search": "Pythagorean theorem",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.trigonometry",
      "name_zh": "三角函数",
      "name_en": "Trigonometry",
      "type": "CONCEPTUAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "用 sin/cos/tan 把角度和边长换算，把‘朝某方向走一段’拆成横竖两个分量。火星车按航向角把前进距离拆成经纬度增量画路径，义肢课把腱线行程换算成手指弯曲角度都靠它。",
      "wikidata_search": "trigonometry sine cosine",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.vector",
      "name_zh": "向量",
      "name_en": "Vector",
      "type": "CONCEPTUAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "既有大小又有方向的量，可写成一串坐标数。脑波课把每时刻各电极的值当一个高维箭头、把一个 trial 压成特征向量，分子课用一串描述符数字表示一个分子，是喂给模型的标准形式，也是线性代数的起点。",
      "wikidata_search": "vector mathematics",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.vector_space",
      "name_zh": "向量空间",
      "name_en": "Vector space",
      "type": "CONCEPTUAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "一堆向量能相加、能缩放，共同张成的高维空间。脑波课把信号从时间线重新理解成高维空间里一团箭头，才能在里面找投影方向；特征向量、协方差都活在这个空间里。",
      "wikidata_search": "vector space linear algebra",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.dimension",
      "name_zh": "维度",
      "name_en": "Dimension (vector space)",
      "type": "CONCEPTUAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "描述一个东西需要几个独立坐标数。脑波数据是 试验×通道×时间 的三维数组，一个分子用几十个描述符就是几十维特征，理解维度才拿得住这些多维数据的形状。",
      "wikidata_search": "dimension vector space",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.dot_product",
      "name_zh": "点积",
      "name_en": "Dot product",
      "type": "PROCEDURAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "两个向量对应分量相乘再相加得一个数，衡量它们方向有多一致。脑波课把信号向量点到某个方向轴上就得到一路新信号(投影的核心运算)，也是相似度和夹角计算的底层。",
      "wikidata_search": "dot product inner product",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.norm",
      "name_zh": "范数(向量长度)",
      "name_en": "Norm (vector length)",
      "type": "PROCEDURAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "一个向量有多长，由各分量平方和开根得到(就是勾股推广到高维)。脑波课投影后取信号方差本质是量向量长度/能量，分子指纹比距离、误差大小都用到范数。",
      "wikidata_search": "norm vector length",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.projection",
      "name_zh": "投影",
      "name_en": "Vector projection",
      "type": "PROCEDURAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "把一个向量压到某根方向轴上、只留该方向的分量。脑波项目选一根新方向把那团箭头压成一路一维信号，换方向抖动会变大变小，CSP 就是自动找最能区分两类想象的投影方向。",
      "wikidata_search": "vector projection",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.rotation",
      "name_zh": "旋转",
      "name_en": "Rotation (geometry)",
      "type": "CONCEPTUAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "把点或向量绕一个中心转一个角度，位置变方向变但长度不变。火星车靠航向角把坐标系整体旋转来对齐路径，义肢舵机按角度旋转带动手指，分子的可旋转键让结构绕单键转，都是旋转在起作用。",
      "wikidata_search": "rotation geometry transformation",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.coordinate_transformation",
      "name_zh": "坐标变换",
      "name_en": "Coordinate transformation",
      "type": "PROCEDURAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "在不同坐标系之间换算同一个点(平移+旋转+缩放的组合)。火星车把一串经纬度加航向变换成图上看得见的行驶路线，卫星考古把地球表面位置映射成可计算坐标让像素和真实地点对齐。",
      "wikidata_search": "coordinate transformation",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.riemannian_geometry",
      "name_zh": "黎曼几何",
      "name_en": "Riemannian geometry",
      "type": "CONCEPTUAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "研究弯曲空间上怎么量距离和角度，不再是平直的欧氏空间。脑波高阶做法把每个 trial 的协方差矩阵当弯曲空间里一个点，用专门的黎曼距离(而非直线距离)来分类想象动作。",
      "wikidata_search": "Riemannian geometry manifold",
      "wikidata": "",
      "wikidata_label": ""
    }
  ],
