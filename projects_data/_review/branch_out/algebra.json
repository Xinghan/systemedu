{
  "concepts": [
    {
      "id": "m.variable",
      "name_zh": "变量与未知数",
      "name_en": "Variable",
      "type": "CONCEPTUAL",
      "grade_band": "elementary",
      "subject": "Mathematics",
      "description": "用一个字母代表一个会变化或还不知道的数，比如用 x 代表'现在的温度'、用 gain 代表'放大倍数'。斯特林发电和空气质量项目里所有程序变量(readPower、gain、误差 e)本质都是这个数学思想：先给量起个名字，再对名字做运算。",
      "wikidata_search": "Variable mathematics",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.equation_equality",
      "name_zh": "等式与等号平衡",
      "name_en": "Equation",
      "type": "CONCEPTUAL",
      "grade_band": "elementary",
      "subject": "Mathematics",
      "description": "等号两边一样重，像天平；改一边就得改另一边保持平衡。这是列出'误差 = 目标温度 − 实测温度'、'AQI 由浓度算出'这类关系式的起点，斯特林控制器算误差、空气质量节点手算 AQI 都靠写等式。",
      "wikidata_search": "Equation",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.proportional_relationship",
      "name_zh": "正比例关系",
      "name_en": "Proportional relationship",
      "type": "CONCEPTUAL",
      "grade_band": "elementary",
      "subject": "Mathematics",
      "description": "一个量变大另一个量按同样倍数变大，比如'用力越大手指弯得越多'、'颗粒越多读数越高'。义肢项目把肌肉强度成比例映射成 0-100% 用力、空气质量画'浓度越高 AQI 越高'的对照直线，都是先认出正比这层关系。",
      "wikidata_search": "Proportionality mathematics",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.ratio",
      "name_zh": "比值",
      "name_en": "Ratio",
      "type": "PROCEDURAL",
      "grade_band": "elementary",
      "subject": "Mathematics",
      "description": "两个数相除得到的量，妙处是能约掉整体明暗、总量的影响。卫星考古的所有归一化植被/水体指数(NDVI、NDWI)都是波段相除，火星车按类别比例统计样本，比值是这些'消掉背景只看相对关系'算法的核心。",
      "wikidata_search": "Ratio",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.algebraic_expression",
      "name_zh": "代数表达式",
      "name_en": "Algebraic expression",
      "type": "PROCEDURAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "把变量、数字和加减乘除组合成一个可求值的式子，如 Kp·e 或 (NIR−R)/(NIR+R)。斯特林 P 控制器的输出、卫星光谱指数的一整条计算式，都是先写成代数表达式再翻译成代码。",
      "wikidata_search": "Expression mathematics",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.linear_equation",
      "name_zh": "一次方程",
      "name_en": "Linear equation",
      "type": "PROCEDURAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "只含一次项的方程，形如 y = a·x + b，解它就是求某个未知量。空气质量项目的传感器校正公式(把原始读数线性纠成真值)、义肢把强度线性折算成用力等级，都是在建并解一次方程。",
      "wikidata_search": "Linear equation",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.cartesian_coordinates",
      "name_zh": "平面直角坐标系",
      "name_en": "Cartesian coordinate system",
      "type": "REPRESENTATIONAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "用横纵两条数轴给平面上每个点一对坐标 (x, y)，把数变成看得见的位置。空气质量项目画散点图、卫星把特征点摆进坐标、脑波项目把电极信号当成坐标里的向量，全靠这套坐标系当画布。",
      "wikidata_search": "Cartesian coordinate system",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.function",
      "name_zh": "函数",
      "name_en": "Function (mathematics)",
      "type": "CONCEPTUAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "一台'输入一个数、吐出一个数'的机器，同一个输入永远给同一个输出。空气质量把 NowCast、校正封装成可复用函数，斯特林把 readPower/hillClimbTick 写成带 return 的函数，数学'函数'正是这些程序函数的原型。",
      "wikidata_search": "Function mathematics",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.linear_function",
      "name_zh": "一次函数与线性关系",
      "name_en": "Linear function",
      "type": "REPRESENTATIONAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "图像是一条直线的函数 y = k·x + b，表示两个量匀速一起变。空气质量项目用它画'浓度越高 AQI 越高'的对照直线、做传感器线性校正，是校准这门手艺最基础的模型。",
      "wikidata_search": "Linear function",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.slope",
      "name_zh": "斜率",
      "name_en": "Slope",
      "type": "CONCEPTUAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "直线的陡峭程度，等于 y 变化量除以 x 变化量，代表'x 每加 1，y 涨多少'。斯特林 P 控制的增益 Kp、义肢强度到用力的映射斜率、AQI 分段插值每一段的斜率，都是这同一个量在不同项目里的化身。",
      "wikidata_search": "Slope",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.geometric_sequence",
      "name_zh": "几何级数",
      "name_en": "Geometric sequence",
      "type": "PROCEDURAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "每一项都是上一项乘同一个固定倍数的数列，如 1, 1/2, 1/4…。空气质量项目算 EPA NowCast 时给越旧的读数按折半规律配越小的权重，正是用几何级数造出'近的重、远的轻'的加权。",
      "wikidata_search": "Geometric progression",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.system_of_equations",
      "name_zh": "方程组",
      "name_en": "System of equations",
      "type": "PROCEDURAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "同时成立的几个方程，一起解出多个未知量。脑波项目的线性判别分析(LDA)找那条最能分开两类的直线、最小二乘拟合求最佳斜率和截距，背后都是在解一组联立方程。",
      "wikidata_search": "System of linear equations",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.quadratic_function",
      "name_zh": "二次函数",
      "name_en": "Quadratic function",
      "type": "REPRESENTATIONAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "图像是一条开口抛物线的函数 y = a·x²+b·x+c，有唯一的最高或最低点(顶点)。斯特林发电机'存在一个最优工作点、功率随参数先升后降'恰是这种单峰形状，爬山寻优就是在这条抛物线上找顶点。",
      "wikidata_search": "Quadratic function",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.exponential_function",
      "name_zh": "指数函数",
      "name_en": "Exponential function",
      "type": "REPRESENTATIONAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "自变量在指数位置、增长/衰减越来越快的函数 y = a·bˣ。它是理解对数尺度的前一半：分子项目的溶解度、脂水分配跨好几个数量级，只有先懂指数增长才看得懂为什么要用对数压缩。",
      "wikidata_search": "Exponential function",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.logarithm",
      "name_zh": "对数与对数尺度",
      "name_en": "Logarithm",
      "type": "CONCEPTUAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "指数的逆运算，能把跨好几个数量级的大范围压成好读的小刻度。分子项目的 LogP(脂水分配)本身就是取对数得到的分子描述符，用对数尺度才能把从极亲水到极亲脂的分子放进同一根轴比较。",
      "wikidata_search": "Logarithm",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.polynomial",
      "name_zh": "多项式",
      "name_en": "Polynomial",
      "type": "CONCEPTUAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "由变量的各次幂加权相加组成的式子，一次、二次都是它的特例，次数越高能画出越弯的曲线。它是多项式拟合的地基：当传感器校正曲线不是一条直线而是弯的时候，就要用更高次的多项式去贴。",
      "wikidata_search": "Polynomial",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.least_squares",
      "name_zh": "最小二乘法",
      "name_en": "Least squares",
      "type": "PROCEDURAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "通过让所有点到曲线的残差平方和最小，来求最佳拟合线/面的通用方法。空气质量项目的趋势线拟合、传感器校正系数、R² 的计算全建立在它之上，是'从散点里找出那条最对的线'的数学引擎。",
      "wikidata_search": "Least squares",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.polynomial_regression",
      "name_zh": "多项式拟合",
      "name_en": "Polynomial regression",
      "type": "PROCEDURAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "用二次及以上的多项式去拟合弯曲的数据关系，比直线更贴合非线性响应。当空气质量传感器在高湿度下读数偏差不是线性时，用多项式校正曲线代替单纯直线校正能显著提高吻合度。",
      "wikidata_search": "Polynomial regression",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.piecewise_interpolation",
      "name_zh": "分段线性插值",
      "name_en": "Piecewise linear interpolation",
      "type": "PROCEDURAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "把整条曲线拆成一段段直线、在已知断点之间按比例估中间值。空气质量项目手算 AQI 时，浓度落在两个官方断点之间就用这一段的斜率线性插值，得到精确的指数分值。",
      "wikidata_search": "Linear interpolation",
      "wikidata": "",
      "wikidata_label": ""
    }
  ],
