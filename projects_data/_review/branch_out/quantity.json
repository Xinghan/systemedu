{
  "concepts": [
    {
      "id": "m.counting_and_tally",
      "name_zh": "计数与频数",
      "name_en": "Counting and tallying",
      "type": "PROCEDURAL",
      "grade_band": "elementary",
      "subject": "Mathematics",
      "description": "一个一个数、按类划正字统计个数, 是所有量化的起点。蚂蚁项目按个体分组数'今天出门几次', 斯特林项目数一秒内飞轮转了几个脉冲——都从'会数数'开始。",
      "wikidata_search": "Counting",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.fraction",
      "name_zh": "分数",
      "name_en": "Fraction",
      "type": "CONCEPTUAL",
      "grade_band": "elementary",
      "subject": "Mathematics",
      "description": "把整体切成相等的几份、取其中几份, 是比例和百分比的地基。卫星考古'每一百个像素占几份'、火星车'每类图片占几成'都先要会用分数表达部分与整体。",
      "wikidata_search": "Fraction",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.ratio",
      "name_zh": "比值",
      "name_en": "Ratio",
      "type": "CONCEPTUAL",
      "grade_band": "elementary",
      "subject": "Mathematics",
      "description": "两个数相除得到的量, 妙处是能约掉整体大小只留相对关系。卫星考古用它做归一化指数(消掉整片明暗)、空气项目用个数比质量理解粒子, 是所有归一化的核心。",
      "wikidata_search": "Ratio",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.percentage",
      "name_zh": "百分比",
      "name_en": "Percentage",
      "type": "CONCEPTUAL",
      "grade_band": "elementary",
      "subject": "Mathematics",
      "description": "每一百份里占几份的表达, 让不同大小的量能公平比较。火星车看'每类占几成'判断数据平不平衡, 卫星考古用它缩放像素统计量, 脑波项目用它读准确率(判对的比例)。",
      "wikidata_search": "Percentage",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.proportion_scaling",
      "name_zh": "成比例与按比例缩放",
      "name_en": "Proportion and proportional scaling",
      "type": "CONCEPTUAL",
      "grade_band": "elementary",
      "subject": "Mathematics",
      "description": "两个量一个变大另一个也成倍变大(y=kx 的直觉), 会按比例放大缩小。空气项目在浓度断点之间'按比例'插值算 AQI、义肢项目把弯曲角度按比例映射到舵机, 都靠成比例关系。",
      "wikidata_search": "Proportionality (mathematics)",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.arithmetic_mean",
      "name_zh": "算术平均数",
      "name_en": "Arithmetic mean",
      "type": "PROCEDURAL",
      "grade_band": "elementary",
      "subject": "Mathematics",
      "description": "一堆数加起来除以个数, 用一个代表数概括整体。几乎每门课都用: 脑波/肌电把一段信号概括成强度、空气项目把一天几百个读数压成一个数、卫星考古把一片像素摊平成一个值。",
      "wikidata_search": "Arithmetic mean",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.weighted_average",
      "name_zh": "加权平均",
      "name_en": "Weighted average",
      "type": "PROCEDURAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "让某些数更有发言权(权重更大)再求平均, 不是人人平等。空气项目的 NowCast 核心就是加权平均(越近的读数权重越大), 分子项目把多个指标加权合成一个排名分挑 Top10。",
      "wikidata_search": "Weighted arithmetic mean",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.moving_average",
      "name_zh": "滑动/移动平均",
      "name_en": "Moving average",
      "type": "PROCEDURAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "对最近 N 个数连续求平均得到平滑曲线, 压掉抖动但会带来滞后。肌电项目用它把乱跳的肌电变成稳定的用力强度, 斯特林项目用它平滑转速读数, 空气项目滚动窗口也是它。",
      "wikidata_search": "Moving average",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.aggregation",
      "name_zh": "分组与聚合",
      "name_en": "Grouping and aggregation",
      "type": "PROCEDURAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "先按类别把数据分堆, 再对每堆做计数/求和/平均。蚂蚁项目按个体分组算'每只蚁出门多少次', 是从一大表原始记录得到每类汇总量的通用套路。",
      "wikidata_search": "Aggregate function",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.variance",
      "name_zh": "方差",
      "name_en": "Variance",
      "type": "PROCEDURAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "每个点离平均值差的平方再平均, 客观量出一堆数抖得厉害还是平稳。脑波项目用它描述信号波动、当均值≈0 时方差等于信号能量, 是 CSP 特征提取的核心量。",
      "wikidata_search": "Variance",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.standard_deviation",
      "name_zh": "标准差",
      "name_en": "Standard deviation",
      "type": "PROCEDURAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "方差开根号, 回到和原数据同单位的'典型波动幅度'。蚂蚁项目用'超出平均 2 个标准差'挑出异常活跃的先锋个体(找网红蚁), 是离群值判定的标尺。",
      "wikidata_search": "Standard deviation",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.units_and_conversion",
      "name_zh": "单位与量的换算",
      "name_en": "Units and unit conversion",
      "type": "PROCEDURAL",
      "grade_band": "elementary",
      "subject": "Mathematics",
      "description": "给数量配上单位、在单位间换算(如微米↔毫米、毫伏↔伏)。空气项目用微米理解颗粒多小(头发丝约70微米)、斯特林项目把脉冲数换算成每分钟转速, 都靠会换单位。",
      "wikidata_search": "Conversion of units",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.si_prefix",
      "name_zh": "SI 单位前缀",
      "name_en": "SI prefix",
      "type": "LANGUAGE",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "毫/微/千/兆等前缀代表固定的十的幂(毫=千分之一、微=百万分之一), 是读懂数量级的符号系统。肌电项目靠'毫'读懂毫伏 mV、脑波项目靠'微'读懂微伏量级。",
      "wikidata_search": "Metric prefix",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.orders_of_magnitude",
      "name_zh": "数量级",
      "name_en": "Orders of magnitude",
      "type": "CONCEPTUAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "用十倍标尺比较大小, 差一个数量级就是差十倍。肌电项目用它建立'毫伏比电池弱一千倍'的直觉, 空气项目用它感受微米颗粒有多小, 是估算和数感的基础。",
      "wikidata_search": "Order of magnitude",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.scientific_notation",
      "name_zh": "科学计数法",
      "name_en": "Scientific notation",
      "type": "REPRESENTATIONAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "把非常大或非常小的数写成 a×10ⁿ, 一眼看清数量级。脑波的微伏(约10⁻⁶伏)、肌电的毫伏、空气项目的微米粒径都极端小, 用科学计数法才好表达和比较。",
      "wikidata_search": "Scientific notation",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.logarithmic_scale",
      "name_zh": "对数尺度",
      "name_en": "Logarithmic scale",
      "type": "REPRESENTATIONAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "刻度按十倍(而非等差)递进的尺子, 让跨好几个数量级的量能画在一张图上。脑波频谱、信噪比、颗粒粒径分布这些量跨度巨大, 用对数尺度才看得清; 也是理解分贝/信噪比的基础。",
      "wikidata_search": "Logarithmic scale",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.geometric_sequence",
      "name_zh": "几何级数与指数衰减",
      "name_en": "Geometric sequence and exponential decay",
      "type": "CONCEPTUAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "每项按固定倍数递减(如逐次折半)的数列, 越老的数据权重越小。空气项目的 NowCast 用几何级数式的折半权重让近期读数更重要, 是自适应加权平均的数学来源。",
      "wikidata_search": "Geometric progression",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.normalization",
      "name_zh": "归一化",
      "name_en": "Normalization",
      "type": "PROCEDURAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "用比值或缩放把不同量纲/不同大小的数拉到可比范围(常到 0~1)。卫星考古用归一化差值算 NDVI/NDWI 消掉光照影响, 肌电项目把用力强度归一化到 0~1 再映射舵机。",
      "wikidata_search": "Normalization (statistics)",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.absolute_error",
      "name_zh": "绝对误差与平均绝对误差",
      "name_en": "Absolute error and mean absolute error",
      "type": "PROCEDURAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "预测减真实取绝对值(不管正负)再平均, 用一个数说清'平均差多少'。空气项目用 MAE 量自制传感器跟官方站的距离, 分子项目用 MAE/RMSE 衡量溶解度预测准不准。",
      "wikidata_search": "Mean absolute error",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.signed_bias",
      "name_zh": "带符号偏差",
      "name_en": "Signed bias",
      "type": "CONCEPTUAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "带正负的平均偏移量, 判断是不是一直系统性偏高或偏低(而非随机误差)。空气项目用它看传感器读数是否总体偏大, 区分系统误差与随机误差、指导校正方向。",
      "wikidata_search": "Bias of an estimator",
      "wikidata": "",
      "wikidata_label": ""
    }
  ],
