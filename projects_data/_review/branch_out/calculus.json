{
  "concepts": [
    {
      "id": "m.rate_of_change",
      "name_zh": "变化率直觉",
      "name_en": "Rate of change",
      "type": "CONCEPTUAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "一个量随时间/位置变多快 —— 温度每分钟升几度、误差每一轮变多少。斯特林控制器看误差'变化速度'提前收力、义肢 PID 的 D 项都靠它,是所有微分控制的直觉起点。",
      "wikidata_search": "rate of change",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.slope_as_rate",
      "name_zh": "斜率即变化率",
      "name_en": "Slope as rate of change",
      "type": "CONCEPTUAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "把变化率画成图上一条线的陡峭程度:线越陡变得越快。空气质量项目用直线斜率把 PM 浓度换算成 AQI、火星车把经纬度序列的斜率读成航向,都是在读斜率这个变化率。",
      "wikidata_search": "slope",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.instantaneous_rate",
      "name_zh": "瞬时变化率(极限直觉)",
      "name_en": "Instantaneous rate of change",
      "type": "CONCEPTUAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "把两点间的平均变化率不断缩短间隔,逼近'这一瞬间'变多快 —— 就是极限。这是从'过去一段时间平均变化'跳到'此刻导数'的桥,义肢/斯特林的 D 控制其实在估这个瞬时斜率。",
      "wikidata_search": "instantaneous rate of change limit",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.derivative",
      "name_zh": "导数",
      "name_en": "Derivative",
      "type": "CONCEPTUAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "函数在每一点的瞬时变化率,写成一个新函数。控制里的微分项 D 就是对误差求导:斯特林/义肢用它看误差变多快、提前刹车抑制过冲。也是梯度下降、反向传播的数学基底。",
      "wikidata_search": "derivative",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.moving_average_smoothing",
      "name_zh": "滑动平均(离散平滑)",
      "name_en": "Moving average smoothing",
      "type": "PROCEDURAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "拿一个小窗口在数据流上滑动、每步求平均,把毛刺抹平 —— 是积分(累加)在离散信号上的落地形态,也是最简单的低通滤波。义肢肌电、斯特林转速、空气质量读数都用它先降噪再判断。",
      "wikidata_search": "moving average",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.area_under_curve",
      "name_zh": "曲线下面积",
      "name_en": "Area under a curve",
      "type": "CONCEPTUAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "把一条曲线和横轴之间围出的面积算出来,直觉上就是把很多细窄条累加。分子项目的 ROC 曲线下面积 AUC、把整流后的肌电幅度沿时间累计成'总用力',都是在求这块面积。",
      "wikidata_search": "area under the curve",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.integral",
      "name_zh": "积分(累加)",
      "name_en": "Integral",
      "type": "CONCEPTUAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "把一个量随时间/空间连续累加起来,是求和的连续版。控制里的积分项 I 就是把历史误差一直累加以消掉稳态残差(斯特林/义肢),空气质量的 NowCast、几何加权平均、滚动窗口聚合也是各种累加。",
      "wikidata_search": "integral",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.differential",
      "name_zh": "微分",
      "name_en": "Differential",
      "type": "CONCEPTUAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "把变化拆成无穷小的一小步 dx 及其带来的 dy,是导数与积分共用的'微小增量'语言。信号处理里对采样数据做逐点差分、控制律推导都建立在这套微小量运算上。",
      "wikidata_search": "differential of a function",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.fundamental_theorem_calculus",
      "name_zh": "微积分基本定理",
      "name_en": "Fundamental theorem of calculus",
      "type": "CONCEPTUAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "求导和积分互为逆运算 —— 累加的斜率变回原量,原量累加再求斜率还是它。这把 PID 里微分项 D 和积分项 I 统一起来,解释了为何 D 看变化、I 看累积却服务同一套控制。",
      "wikidata_search": "fundamental theorem of calculus",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.gradient",
      "name_zh": "梯度",
      "name_en": "Gradient",
      "type": "CONCEPTUAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "多个变量一起时,导数变成一个指向'上升最快方向'的向量。机器学习靠它知道每个参数该往哪调:斯特林的梯度下降、分子的 XGBoost 梯度提升、各课神经网络训练都沿梯度反方向走。",
      "wikidata_search": "gradient",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.gradient_descent",
      "name_zh": "梯度下降",
      "name_en": "Gradient descent",
      "type": "PROCEDURAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "沿梯度反方向一小步一小步下山,把误差/损失降到最低,是几乎所有模型训练的优化引擎。斯特林用它找最大功率工作点、卫星/火星/分子项目训练网络最小化损失函数都靠它。",
      "wikidata_search": "gradient descent",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.frequency",
      "name_zh": "频率",
      "name_en": "Frequency",
      "type": "CONCEPTUAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "一个成分波一秒重复多少次(赫兹),描述'快波慢波'。脑波项目用它区分 alpha/beta 频段、义肢靠它认出叠在肌电上的 50Hz 工频干扰、蚂蚁 RFID 线圈也工作在特定频率。",
      "wikidata_search": "frequency",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.amplitude",
      "name_zh": "幅度",
      "name_en": "Amplitude",
      "type": "CONCEPTUAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "一个震荡波摆动的强弱高低。肌电整流后幅度越大代表越用力、脑波频谱图里每个频率成分的高度就是它的幅度,是把'信号有多强'量化出来的基础量。",
      "wikidata_search": "amplitude",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.phase",
      "name_zh": "相位",
      "name_en": "Phase",
      "type": "CONCEPTUAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "同一频率的两个波在时间上错开多少(以角度/圈计)。斯特林两活塞相差约 90 度相位才转得起来、0 或 180 度就不转,相位是描述这种'步调错开'的量。",
      "wikidata_search": "phase (waves)",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.fourier_transform",
      "name_zh": "傅里叶变换",
      "name_en": "Fourier transform",
      "type": "CONCEPTUAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "把一段随时间起伏的信号拆成各种频率成分的强弱(频谱),是频率+幅度+相位的合体运算。脑波项目正是靠它把 EEG 拆成 alpha/beta 各频段、画出频谱图、做带通滤波。",
      "wikidata_search": "Fourier transform",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.convolution",
      "name_zh": "卷积",
      "name_en": "Convolution",
      "type": "PROCEDURAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "拿一个小窗(核)在信号或图像上一格格滑、逐点相乘再相加,提取局部花纹。火星车/卫星考古的 CNN、脑波的 EEGNet 都用它看形状,滤波/边缘检测本质也是卷积。",
      "wikidata_search": "convolution",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.laplace_transform",
      "name_zh": "拉普拉斯变换",
      "name_en": "Laplace transform",
      "type": "CONCEPTUAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "把随时间变化的控制系统搬到频域(复频率 s 域)分析,让微分/积分变成代数运算。斯特林大学阶用它写传递函数、看极点与稳定裕度、画根轨迹判断闭环稳不稳。",
      "wikidata_search": "Laplace transform",
      "wikidata": "",
      "wikidata_label": ""
    }
  ],
