{
  "concepts": [
    {
      "id": "m.arithmetic_mean",
      "name_zh": "平均数",
      "name_en": "Arithmetic mean",
      "type": "PROCEDURAL",
      "grade_band": "elementary",
      "subject": "Mathematics",
      "description": "把一堆数加起来除以个数,用一个代表数概括总体多大 —— 脑波/空气质量/卫星考古项目都用它把一段时间几百个读数或一片像素值压成一个数。",
      "wikidata_search": "arithmetic mean",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.percentage",
      "name_zh": "百分比",
      "name_en": "Percentage",
      "type": "PROCEDURAL",
      "grade_band": "elementary",
      "subject": "Mathematics",
      "description": "每一百份里占几份的表达方式 —— 火星车项目用它数每类地貌占几成、卫星考古用它缩放和理解像素统计量,是理解类别比例的地基。",
      "wikidata_search": "percentage",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.ratio_proportion",
      "name_zh": "比例",
      "name_en": "Ratio and proportion",
      "type": "CONCEPTUAL",
      "grade_band": "elementary",
      "subject": "Mathematics",
      "description": "两个量的相对多少关系(几比几) —— 火星车项目用它建立平均与比例直觉、判断数据集里各类地貌是否均衡,卫星考古用比值算光谱指数。",
      "wikidata_search": "ratio proportion",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.count_statistics",
      "name_zh": "计数统计",
      "name_en": "Counting and frequency",
      "type": "PROCEDURAL",
      "grade_band": "elementary",
      "subject": "Mathematics",
      "description": "数每类各有多少、出现几次 —— 蚂蚁项目数每只个体被读到几次、分子项目对全库分子计数、混淆矩阵每格填的就是计数,是所有统计的第一步。",
      "wikidata_search": "frequency count statistics",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.weighted_average",
      "name_zh": "加权平均",
      "name_en": "Weighted average",
      "type": "PROCEDURAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "让近的数据权重大、远的权重小地求平均 —— 空气质量项目的 EPA NowCast 用折半权重加权近几小时读数,让最新变化更快反映到 AQI。",
      "wikidata_search": "weighted arithmetic mean",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.median_mode",
      "name_zh": "中位数与众数",
      "name_en": "Median and mode",
      "type": "CONCEPTUAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "中位数是排序后中间那个、众数是出现最多的那个 —— 比平均数更抗极端值,空气质量/蚂蚁项目遇到少数异常大读数时,用它们看清'典型值'到底在哪。",
      "wikidata_search": "median mode statistics",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.probability",
      "name_zh": "概率",
      "name_en": "Probability",
      "type": "CONCEPTUAL",
      "grade_band": "middle",
      "subject": "Mathematics",
      "description": "一件事发生可能性的 0 到 1 数值 —— 火星车/分子/卫星考古的模型输出的不是硬结论而是'80% 像 dune'这种把握程度,理解概率才能读懂模型的置信度。",
      "wikidata_search": "probability",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.variance",
      "name_zh": "方差",
      "name_en": "Variance",
      "type": "PROCEDURAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "每个点离平均值差的平方再平均,客观描述一串数抖得厉害还是平稳 —— 脑波项目里带通后信号方差就等于能量,是判断'哪路电极最能区分想左右手'的核心量。",
      "wikidata_search": "variance statistics",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.standard_deviation",
      "name_zh": "标准差",
      "name_en": "Standard deviation",
      "type": "PROCEDURAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "方差开平方,回到和原数据同单位的'平均波动幅度' —— 蚂蚁项目用超出平均 2 个标准差(2σ)挑出异常活跃的少数个体来找 pioneer 侦察蚁。",
      "wikidata_search": "standard deviation",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.distribution",
      "name_zh": "分布",
      "name_en": "Probability distribution",
      "type": "CONCEPTUAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "一批数据在不同取值上如何铺开(集中在哪、有没有长尾) —— 分子项目用它看全库分子量/极性表面积的散布,采样和挑异常值都要先知道数据长什么样。",
      "wikidata_search": "probability distribution",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.histogram",
      "name_zh": "直方图",
      "name_en": "Histogram",
      "type": "REPRESENTATIONAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "把数据分成一段段区间、用柱子高度表示每段有多少个的图 —— 分子项目用 RDKit 给全库'称重'后画分子量直方图,一眼看出分布形状和离群。",
      "wikidata_search": "histogram",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.correlation",
      "name_zh": "相关",
      "name_en": "Correlation",
      "type": "CONCEPTUAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "两个量是否一起变、方向和强弱 —— 空气质量项目从湿度散点图第一次看见传感器读数随湿度一起涨,是理解校准和'相关不等于因果'的入口。",
      "wikidata_search": "correlation statistics",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.scatter_plot",
      "name_zh": "散点图",
      "name_en": "Scatter plot",
      "type": "REPRESENTATIONAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "把两个量当横竖坐标、每个样本画成一个点的图 —— 空气质量项目把自建传感器读数对官方站画散点,脑波项目把两电极值画散点,是看相关与回归的画布。",
      "wikidata_search": "scatter plot",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.linear_regression",
      "name_zh": "线性回归",
      "name_en": "Linear regression",
      "type": "PROCEDURAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "找一条让总残差最小的直线穿过散点群(最小二乘) —— 空气质量项目用它拟合自建传感器对官方站的校准直线,把系统偏差纠正过来。",
      "wikidata_search": "linear regression least squares",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.residual",
      "name_zh": "残差",
      "name_en": "Residual",
      "type": "CONCEPTUAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "每个真实点到拟合线的竖直差距 —— 空气质量项目看残差判断拟合好不好、有没有系统性偏离,残差平方和最小就是最佳拟合线的定义。",
      "wikidata_search": "residual regression",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.error_metric",
      "name_zh": "误差度量",
      "name_en": "Error metric",
      "type": "PROCEDURAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "用一个数说清预测离真实有多远(平均绝对误差 MAE、均方根 RMSE) —— 空气质量项目用 MAE 量自建站和官方站的距离,分子项目用 MAE/RMSE 衡量溶解度预测准不准。",
      "wikidata_search": "mean absolute error RMSE",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.statistical_bias",
      "name_zh": "偏差",
      "name_en": "Bias (statistics)",
      "type": "CONCEPTUAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "带正负号的平均偏移,判断是不是一直系统性偏高或偏低 —— 空气质量项目用它区分'系统误差'(可校准掉)和'随机误差'(抖动),决定校准该怎么做。",
      "wikidata_search": "bias statistics",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.confusion_matrix",
      "name_zh": "混淆矩阵",
      "name_en": "Confusion matrix",
      "type": "REPRESENTATIONAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "一张表数清模型把每一类各认成了哪一类(真阳/假阳/假阴/真阴) —— 火星车 5x5、分子/卫星考古 2x2 都用它看穿'准确率骗局',是评估分类器的核心工具。",
      "wikidata_search": "confusion matrix",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.precision_recall",
      "name_zh": "查准率与查全率",
      "name_en": "Precision and recall",
      "type": "PROCEDURAL",
      "grade_band": "high",
      "subject": "Mathematics",
      "description": "从混淆矩阵算出的两个诚实指标(找对的里有多少真对 / 该找的里找回多少) —— 分子/卫星考古在稀有正样本下用它,比整体准确率有意义得多。",
      "wikidata_search": "precision and recall",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.covariance",
      "name_zh": "协方差",
      "name_en": "Covariance",
      "type": "PROCEDURAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "两个量是否一起抖压成一个带符号的数(正同向负反向),且保留各自能量信息 —— 脑波项目用两电极协方差刻画它们如何协同,是相关的未标准化版本、CSP 的原料。",
      "wikidata_search": "covariance",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.matrix",
      "name_zh": "矩阵",
      "name_en": "Matrix",
      "type": "REPRESENTATIONAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "把一堆数排成方格表,行列都有意义 —— 分子项目一行一个分子的全部数字拼成特征矩阵,脑波项目把电极两两关系排成方表,是协方差矩阵/混淆矩阵的通用容器。",
      "wikidata_search": "matrix mathematics",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.covariance_matrix",
      "name_zh": "协方差矩阵",
      "name_en": "Covariance matrix",
      "type": "REPRESENTATIONAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "所有电极两两协方差排成的方表(对角线是各自方差) —— 脑波项目用它完整描述各电极如何协同抖动,CSP 和黎曼几何分类都直接拿它当输入。",
      "wikidata_search": "covariance matrix",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.correlation_coefficient",
      "name_zh": "相关系数",
      "name_en": "Correlation coefficient",
      "type": "PROCEDURAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "把协方差按各自波动归一化成 -1 到 1 的相关强度数 —— 空气质量项目用它量化读数和官方站/湿度的关联强弱,卫星考古用空间自相关判断地理上挨近处是否相像。",
      "wikidata_search": "correlation coefficient",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.regression_analysis",
      "name_zh": "回归分析",
      "name_en": "Regression analysis",
      "type": "CONCEPTUAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "预测一个连续数值(而非类别)的任务总框架,含拟合、残差、误差评估 —— 分子项目用它预测溶解度这类连续量,决定系数 R² 说明拟合解释了多少变化。",
      "wikidata_search": "regression analysis",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.bayes_theorem",
      "name_zh": "贝叶斯定理",
      "name_en": "Bayes' theorem",
      "type": "CONCEPTUAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "根据新证据更新一件事概率的规则 —— 决策阈值背后就是权衡不同类的概率,火星车/分子把模型输出的把握度按阈值切成是/否时用的正是这套概率推断思路。",
      "wikidata_search": "Bayes theorem",
      "wikidata": "",
      "wikidata_label": ""
    },
    {
      "id": "m.sampling",
      "name_zh": "采样",
      "name_en": "Sampling (statistics)",
      "type": "CONCEPTUAL",
      "grade_band": "university",
      "subject": "Mathematics",
      "description": "从总体里按一定节奏或规则抽一部分来代表整体 —— 脑波项目每秒采几百个点(采样率)决定时间分辨率,斯特林项目采样间隔太稀会把细节抹平(奈奎斯特启蒙)。",
      "wikidata_search": "sampling statistics",
      "wikidata": "",
      "wikidata_label": ""
    },
